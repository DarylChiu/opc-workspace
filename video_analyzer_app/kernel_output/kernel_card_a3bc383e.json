  "L2_characters": {
    "characters": [
      {
        "name": "刺猬",
        "jung_archetype": "孤儿/愚者",
        "archetype_conflict": "孤儿（渴望归属但害怕伤害）vs 愚者（用自嘲和幽默掩盖脆弱）——刺猬表面自嘲“高危”，实则渴望连接，但恐惧被拒绝，于是用愚者的方式保护自己。",
        "surface_want": "想要不伤害别人地交朋友（“零误伤”），甚至愿意付费交友。",
        "deep_need": "需要被无条件接纳，即使有缺陷（刺）也能被爱，不再孤独。",
        "core_fear": "自己的刺（缺陷）会永远隔离他人，注定孤独终老。",
        "arc": {
          "start": "孤独、自我隔离，用自嘲防御，认为自己是“高危”的麻烦。",
          "catalyst": "同学们用棉花塞住他的刺，创造安全距离，并送他“礼物”。",
          "end": "意识到自己可以被接纳，不再需要独自承受，感受到温暖和归属。"
        }
      },
      {
        "name": "同学们（集体）",
        "jung_archetype": "照顾者/创造者",
        "archetype_conflict": "照顾者（主动关怀）vs 创造者（用创意解决问题）——他们不是单纯同情，而是用棉花塞刺的创造性方法，既保护刺猬也保护自己。",
        "surface_want": "帮助刺猬融入集体，不再孤单。",
        "deep_need": "通过照顾他人来建立集体认同，证明集体可以包容差异。",
        "core_fear": "集体排斥异类，导致分裂或冷漠。",
        "arc": {
          "start": "对刺猬的刺感到畏惧，保持距离。",
          "catalyst": "观察到刺猬的孤独和自嘲，决定行动。",
          "end": "成功用创意和爱接纳刺猬，集体更加团结温暖。"
        }
      }
    ],
    "inter_character_dynamic": "互补与救赎：刺猬的孤独（孤儿）激发了集体的照顾本能（照顾者），而集体的创意（创造者）治愈了刺猬的恐惧。两者从对立（刺vs群体）转为融合，形成镜像关系——刺猬需要集体接纳，集体需要刺猬来证明自己的包容。"
  },

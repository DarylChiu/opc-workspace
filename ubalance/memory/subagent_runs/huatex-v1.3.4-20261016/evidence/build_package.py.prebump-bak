#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""build_package.py — HUATEX Tools · Windows 交付包打包器（S4 · 2026-10-15）

用法：
  python3 portable/tools/build_package.py                     # 生成 deliverables/HUATEX-Tools-Windows-v1-20261015.zip + -MANIFEST.txt
  python3 portable/tools/build_package.py --stage /tmp/x --zip-out /tmp/y.zip --manifest-out /tmp/y-MANIFEST.txt

设计（S4 任务书 §A）：
  · 输入 = **dev 树 `portable/`** ＋ 本文件内嵌的「Windows 专属文件」（.bat / 自检脚本 / 中文文档 / requirements.txt）
    → 全部在 **临时 stage 目录**里生成，dev 树 `portable/config.yaml` **一行不改**。
  · 包内 `config.yaml` = 由 `portable/config.yaml` **定点替换 5 个键**生成（Windows 默认），保留其余键与注释。
  · **排除清单写死在代码里**（见 EXCLUDE_*），并在 MANIFEST 里逐条列出。
  · 生成 **内容清单 + 每文件 sha256 + 包 sha256/大小** → `<zip>-MANIFEST.txt`。
  · **幂等**：所有 zip 条目时间戳固定 = 1980-01-01；相同输入 → 相同 zip 字节 → 相同清单。
  · **自校验**：打包后扫全包，禁止出现客户数据（*.pdf / *客户*.xlsx / 图片 / runs 留痕），发现即报错退出。
"""
import argparse
import ast
import fnmatch
import hashlib
import os
import re
import shutil
import sys
import zipfile
from datetime import datetime

HERE = os.path.dirname(os.path.abspath(__file__))        # .../portable/tools
PORTABLE = os.path.dirname(HERE)                         # .../portable
REPO = os.path.dirname(PORTABLE)                         # workspace 根
DELIV = os.path.join(REPO, 'deliverables')

PKG_DIR_NAME = 'HUATEX-Tools'
VERSION = 'v1.3.3-20261016'
ZIP_BASENAME = 'HUATEX-Tools-Windows-%s.zip' % VERSION
DEFAULT_STAGE = '/tmp/huatex-pkg-stage'
ZIP_TS = (1980, 1, 1, 0, 0, 0)          # 固定时间戳 → zip 可复现（幂等）

# ══════════════ 排除清单（写死在此；MANIFEST 里逐条列出） ══════════════
EXCLUDE_TOP_DIRS = {'runs', 'in', 'out', 'evidence',     # 运行留痕 / 输入输出 / 证据目录（含客户 PDF、470MB 留痕）
                   'dist-assets'}                        # S4.2：内置素材的「暂存目录」，按 installers/tessdata/wheels 另行落地（见 place_assets）
EXCLUDE_ANY_DIRS = {'__pycache__'}                       # 任何层级的字节码缓存
EXCLUDE_NAMES = {'.DS_Store', '.pdftext_cache.json',      # mac 垃圾 + pdf 文本缓存
                 'start.command', 'stop.command',        # mac 专用启停脚本（Windows 包不带）
                 'build_package.py',                     # 打包器本身属开发工具，不随包外发
                 'preflight_win.py'}                     # S4.2：包内 tools/preflight.py 的「源码」，不重复外发
EXCLUDE_PATTERNS = ['config.regression-*.yaml',          # 回归专用配置，不随包外发
                    '*.pyc', '*.pyo', '*.log', '*.tmp', '~$*', '*.zip', '*.swp']

# 允许出现的表格文件（白名单）；其余任何 xlsx/xls/xlsm 一律视为客户数据 → 报错
ALLOWED_XLSX = {'templates/Payment核销-模板.xlsx'}
# 允许出现的占位说明文件（覆盖层新增；非客户数据，亦不属"runs 留痕"）
PLACEHOLDERS = {'runs/说明.txt', 'work/说明.txt'}

# ══════════════ S4.2 · 内置素材（dist-assets/<名> → 包内 <名>） ══════════════
# 素材由「下载步骤」预先落在 portable/dist-assets/ 下；打包时**逐文件校验字节数**，
# 不符或缺文件一律**中止打包**（绝不伪造文件）。
ASSET_SRC_DIR = os.path.join(PORTABLE, 'dist-assets')
ASSET_DIRS = ('installers', 'tessdata', 'wheels')
ASSET_EXPECT = {
    'installers/tesseract-ocr-w64-setup-5.4.0.20240606.exe':
        (50175248, 'Tesseract 5.4.0 安装器（UB-Mannheim 构建，Inno Setup 可静默安装）'),
    'installers/Release-26.09.0-0.zip': (43709956, 'Poppler for Windows 26.09.0（解压即用）'),
    'tessdata/eng.traineddata': (4113088, 'tessdata_fast 语言包 eng'),
    'tessdata/osd.traineddata': (10562727, 'tessdata_fast 语言包 osd（方向检测）'),
    'tessdata/vie.traineddata': (531275, 'tessdata_fast 语言包 vie'),
    'tessdata/chi_sim.traineddata': (2469156, 'tessdata_fast 语言包 chi_sim'),
}
# 客户数据扩展名（打包后扫描用）
FORBIDDEN_EXT = {'.pdf', '.jpg', '.jpeg', '.png', '.gif', '.bmp', '.tif', '.tiff',
                 '.doc', '.docx', '.rar', '.7z', '.eml', '.msg'}


# ══════════════════════════════════════════════════════════════════
#  一、Windows 专属文件（内嵌；全部在临时 stage 目录里生成）
# ══════════════════════════════════════════════════════════════════

START_BAT = r'''@echo off
chcp 936 >nul
rem ============================================================
rem  HUATEX 本地工具台 · Windows 双击启动
rem  双击本文件即可：自检 → 起本地服务 → 自动打开浏览器
rem  （运行期不联网；依赖/OCR 环境由包根 一键安装.bat 一次性装好；只监听 127.0.0.1，其他人访问不到）
rem ============================================================
cd /d "%~dp0"

set "PY="
where py >nul 2>nul && set "PY=py"
if not defined PY ( where python >nul 2>nul && set "PY=python" )
if not defined PY (
  echo.
  echo [x] 没找到 Python。
  echo     请先安装 Python 3.11 或更高版本，安装第一步务必勾选
  echo     "Add python.exe to PATH" 和 "Add Python to environment variables"。
  echo     装完关掉本窗口，重新双击 start.bat。详见《安装清单-Windows.md》。
  echo.
  pause
  exit /b 1
)
echo 使用解释器：%PY%
echo.
%PY% -u tools\preflight.py
set "RC=%ERRORLEVEL%"
if "%RC%"=="3" goto :warn
if %RC% GEQ 2 goto :fatal

:start
echo.
echo 正在启动本地服务（约 2-5 秒）……
echo   页面地址：http://127.0.0.1:8000/   （浏览器会自动打开）
echo   停止服务：双击 stop.bat，或在本窗口按 Ctrl+C
echo.
%PY% -u app\server.py
echo.
echo 服务已退出。
pause
exit /b 0

:warn
echo.
echo ============================================================
echo  注意：自检有 ❌ 项（多为缺少依赖包、缺 Tesseract 或缺 Poppler）。
echo        最快的修法：先双击包根 一键安装.bat（全离线，包内自带素材，可重复运行）。
echo        此时「Payment 核销 / 进出口材料」很可能跑不出结果，
echo        但服务仍会启动。建议先看《自查表-常见报错.md》，
echo        或先双击 selftest.bat 看完整自检报告。
echo.
echo  按任意键仍要启动服务；直接关窗口 = 退出。
echo ============================================================
pause >nul
goto :start

:fatal
echo.
echo ============================================================
echo  启动已中止：自检发现致命问题（见上方提示）。
echo  请按提示修好后重新双击 start.bat；或先双击 selftest.bat。
echo ============================================================
pause
exit /b 2
'''

STOP_BAT = r'''@echo off
chcp 936 >nul
rem ============================================================
rem  HUATEX 本地工具台 · 停止服务
rem  读取 runs\.server.pid 后结束该进程（含子进程）
rem ============================================================
cd /d "%~dp0"
set "PIDFILE=runs\.server.pid"

if not exist "%PIDFILE%" (
  echo [i] 没找到 %PIDFILE% —— 服务应该已经停机了。
  echo     如果页面还能打开，请在启动服务的那个黑窗口里按 Ctrl+C。
  pause
  exit /b 0
)

set "PID="
set /p PID=<"%PIDFILE%"
if not defined PID (
  echo [!] %PIDFILE% 内容异常，已删除。
  del "%PIDFILE%" >nul 2>nul
  pause
  exit /b 1
)

taskkill /PID %PID% /T /F >nul 2>nul
if errorlevel 1 (
  echo [!] 进程 %PID% 不存在或已停止（可能你已手动关闭窗口）。
) else (
  echo [OK] 已停止服务（pid=%PID%）。
)
del "%PIDFILE%" >nul 2>nul
echo.
echo 提示：运行留痕保留在 runs\ 目录，不会被本操作删除。
pause
exit /b 0
'''


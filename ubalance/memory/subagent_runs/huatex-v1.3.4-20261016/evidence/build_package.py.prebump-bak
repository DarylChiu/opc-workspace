_PREFLIGHT_PY_S4_INLINE_UNUSED = r'''#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""preflight.py — 启动前自检 / 自动修复（Windows 交付包专用）

两种用法：
  python tools\\preflight.py              <- start.bat 调用：快速检查 + 自动修复
  python tools\\preflight.py --selftest   <- selftest.bat 调用：完整中文自检报告

退出码：
  0 = 通过；3 = 有警告（缺依赖 / 缺 Tesseract / 数据文件夹没填）仍可启动；
  2 = 致命（Python 版本过低 / 程序目录不可写 / config.yaml 修不好）

做两件"提前发现"的事（都在本地，不联网）：
  1) 输出根回落：config.yaml 的 paths.output_root 若指向不存在的盘（例：D:\\HUATEX\\work 而本机没有 D 盘），
     自动改写为 'work'（= 程序目录下的 work\\），并打印中文说明。
  2) config.yaml 引号修复：Windows 路径带反斜杠，若被写进 YAML 双引号里会导致解析失败
     （页面上填 D:\\HUATEX 就会这样）→ 自动改成单引号并提示。
"""
import importlib
import os
import re
import socket
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))       # .../tools
ROOT = os.path.dirname(HERE)                            # 交付包根目录
CONFIG_YAML = os.path.join(ROOT, 'config.yaml')

DEPS = [
    ('yaml', 'PyYAML', '读 config.yaml'),
    ('openpyxl', 'openpyxl', '读写 Excel'),
    ('pdfplumber', 'pdfplumber', '解析 PDF 文本层'),
    ('pytesseract', 'pytesseract', '调用 OCR'),
    ('PIL', 'Pillow', '图像处理'),
    ('pdf2image', 'pdf2image', 'PDF 转图片（扫描件 OCR）'),
    ('xlrd', 'xlrd', '读老式 .xls'),
]
LANGS = ['vie', 'eng', 'chi_sim']

OK = '\u2705'
NO = '\u274c'
WARN = '\u26a0\ufe0f'


def p(msg=''):
    try:
        sys.stdout.write(str(msg) + '\n')
    except UnicodeEncodeError:                          # 极端控制台编码兜底
        sys.stdout.write(str(msg).encode('ascii', 'replace').decode('ascii') + '\n')
    sys.stdout.flush()


def read_text(path):
    for enc in ('utf-8-sig', 'utf-8'):
        try:
            with open(path, encoding=enc) as fh:
                return fh.read()
        except Exception:
            continue
    return ''


def _line_get(txt, key):
    m = re.search(r'(?m)^[ \t]*' + re.escape(key) + r':[ \t]*(.*)$', txt or '')
    if not m:
        return None
    v = m.group(1).strip()
    if v.startswith('#'):
        return ''
    mc = re.search(r'\s+#', v)
    if mc:
        v = v[:mc.start()].strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in '\'"':
        v = v[1:-1]
    return v


def load_cfg():
    """优先 PyYAML；没有/解析失败则用正则兜底（保证自检本身永远跑得下去）。"""
    txt = read_text(CONFIG_YAML)
    try:
        import yaml
        d = yaml.safe_load(txt) or {}
        g = lambda k: (d or {}).get('paths', {}).get(k)
        ocr = (d or {}).get('ocr', {}) or {}
        srv = (d or {}).get('server', {}) or {}
        return {'source_root': g('source_root') or '', 'output_root': g('output_root') or '',
                'runs_dir': g('runs_dir') or '', 'rm_db': g('rm_db') or 'RM-Database',
                'tesseract_cmd': ocr.get('tesseract_cmd') or '',
                'port': srv.get('port') or 8000, 'yaml_ok': True}
    except Exception:
        return {'source_root': _line_get(txt, 'source_root') or '',
                'output_root': _line_get(txt, 'output_root') or '',
                'runs_dir': _line_get(txt, 'runs_dir') or '',
                'rm_db': _line_get(txt, 'rm_db') or 'RM-Database',
                'tesseract_cmd': _line_get(txt, 'tesseract_cmd') or '',
                'port': int(_line_get(txt, 'port') or 8000), 'yaml_ok': False}


def _rewrite_line(key, value_literal):
    txt = read_text(CONFIG_YAML)
    pat = re.compile(r'(?m)^([ \t]*)' + re.escape(key) + r':[ \t]*.*$')
    if len(pat.findall(txt)) != 1:
        return False
    new = pat.sub(lambda m: m.group(1) + key + ': ' + value_literal, txt)
    tmp = CONFIG_YAML + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as fh:
        fh.write(new)
    os.replace(tmp, CONFIG_YAML)
    return True


def repair_quotes():
    """双击页面填了 D:\\HUATEX 之类 → YAML 双引号里的 \\H 是非法转义 → 解析失败。
    这里把「双引号 + 含反斜杠」的值改成单引号（YAML 单引号内反斜杠是字面量）。"""
    txt = read_text(CONFIG_YAML)
    pat = re.compile(r'(?m)^([ \t]*[A-Za-z_]+:[ \t]*)"([^"\n]*\\[^"\n]*)"([ \t]*#.*)?$')
    new, n = pat.subn(lambda m: m.group(1) + "'" + m.group(2) + "'" + (m.group(3) or ''), txt)
    if n == 0:
        return 0
    tmp = CONFIG_YAML + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as fh:
        fh.write(new)
    os.replace(tmp, CONFIG_YAML)
    return n


def check_config_yaml():
    """返回 (状态, 说明)；状态 'ok' / 'repaired' / 'bad'"""
    txt = read_text(CONFIG_YAML)
    if not txt:
        return 'bad', 'config.yaml 不存在或读不到'
    try:
        import yaml
    except ImportError:
        return 'ok', 'PyYAML 未安装 → 跳过 YAML 解析检查（请先装依赖）'
    try:
        yaml.safe_load(txt)
        return 'ok', 'config.yaml 解析正常'
    except Exception as e1:
        n = repair_quotes()
        if n:
            try:
                yaml.safe_load(read_text(CONFIG_YAML))
                return 'repaired', ('config.yaml 里有 %d 处「Windows 反斜杠路径写在双引号里」，'
                                    '已自动改成单引号并修复' % n)
            except Exception as e2:
                return 'bad', 'config.yaml 仍无法解析：%s' % e2
        return 'bad', 'config.yaml 无法解析：%s' % e1


def fix_output_root(cfg):
    """输出根所在盘不可用 → 回落为程序目录下 work\\。返回 (是否回落, 原值, 现值)。"""
    val = (cfg.get('output_root') or '').strip()
    if not val:
        return False, val, val
    m = re.match(r'^([A-Za-z]):[\\/]', val)              # 形如 D:\... 的绝对盘符路径
    if m:
        drive = m.group(1).upper() + ':\\'
        if not os.path.exists(drive):
            if _rewrite_line('output_root', "'work'   # 由 preflight.py 自动回落（原值 %s 所在盘不可用）" % val):
                return True, val, 'work'
            return False, val, val
    d = val if os.path.isabs(val) else os.path.join(ROOT, val)
    return False, val, val


def check_deps():
    miss, have = [], []
    for mod, pkg, why in DEPS:
        try:
            m = importlib.import_module(mod)
            have.append('%s(%s) %s' % (pkg, getattr(m, '__version__', '?'), why))
        except Exception:
            miss.append(pkg)
    return have, miss


def find_tesseract(cfg):
    cand = []
    if cfg.get('tesseract_cmd'):
        cand.append(cfg['tesseract_cmd'])
    w = shutil_which('tesseract')
    if w:
        cand.append(w)
    for c in cand:
        if c and os.path.isfile(c):
            return c, cand
    return None, cand


def shutil_which(name):
    import shutil
    return shutil.which(name)


def tesseract_langs(exe):
    try:
        r = subprocess.run([exe, '--list-langs'], capture_output=True, timeout=30)
        out = (r.stdout + r.stderr).decode('utf-8', 'replace')
        langs = [ln.strip() for ln in out.splitlines()[1:] if ln.strip()]
        return langs, None
    except Exception as e:
        return None, '%s: %s' % (type(e).__name__, e)


def find_poppler():
    if os.environ.get('POPPLER_PATH'):
        return os.environ['POPPLER_PATH']
    return shutil_which('pdftoppm')


def port_free(port):
    try:
        s = socket.socket()
        s.bind(('127.0.0.1', int(port)))
        s.close()
        return True, None
    except Exception as e:
        return False, '%s' % e


def dir_writable(path):
    try:
        os.makedirs(path, exist_ok=True)
        t = os.path.join(path, '.write_test_preflight')
        with open(t, 'w') as fh:
            fh.write('ok')
        os.remove(t)
        return True, None
    except Exception as e:
        return False, '%s' % e


def python_bits():
    import struct
    return struct.calcsize('P') * 8


def quick():
    """start.bat 用的快速检查：只报最要紧的，附自动修复。"""
    code = 0
    p('── 启动前自检（HUATEX Tools %s）──' % 'v1-20261015')
    # Python
    if sys.version_info < (3, 9):
        p('%s Python 版本过低：%s（需 3.9+，建议 3.11）' % (NO, sys.version.split()[0]))
        return 2
    p('%s Python %s · %d 位 · %s' % (OK, sys.version.split()[0], python_bits(), sys.executable))

    # 程序目录可写
    okdw, err = dir_writable(os.path.join(ROOT, 'runs'))
    if not okdw:
        p('%s 程序目录不可写：%s' % (NO, err))
        p('   把整个文件夹解压到「文档」或 D 盘等普通目录，不要放在 C:\\Program Files 下。')
        return 2
    okw, errw = dir_writable(os.path.join(ROOT, 'work'))
    if not okw:
        p('%s 程序目录下 work\\ 不可写：%s' % (NO, errw))
        code = 3

    # config 解析 / 修复
    st, msg = check_config_yaml()
    if st == 'bad':
        p('%s %s' % (NO, msg))
        p('   处理：用记事本打开 config.yaml，检查是否有路径没加引号；或删掉本文件让它重建。')
        return 2
    p('%s %s' % (OK, msg))
    cfg = load_cfg()

    # 输出根回落
    changed, old, new = fix_output_root(cfg)
    if changed:
        p('%s 输出根 %s 所在盘不可用 → 已自动回落为 程序目录\\work\\' % (WARN, old))
        p('   如需固定输出目录：用记事本改 config.yaml 的 paths.output_root。')
        cfg['output_root'] = new

    # 依赖
    have, miss = check_deps()
    if miss:
        p('%s 缺少依赖：%s' % (WARN, '、'.join(miss)))
        p('   修复（在公司内网/离线环境）：')
        p('     %s -m pip install -r requirements.txt' % sys.executable)
        p('   没有网络时：把离线 wheel 目录放在本包下，然后')
        p('     %s -m pip install --no-index --find-links=wheels -r requirements.txt' % sys.executable)
        code = 3
    else:
        p('%s 依赖 7/7 已安装' % OK)

    # Tesseract
    exe, cand = find_tesseract(cfg)
    if not exe:
        p('%s 没找到 Tesseract（扫描件 OCR 会失败）' % WARN)
        p('   修复：安装 Tesseract-OCR（勾选 Vietnamese + Chinese Simplified + English 语言包），')
        p('         再把 config.yaml 的 ocr.tesseract_cmd 指向 tesseract.exe。')
        code = 3
    else:
        langs, err = tesseract_langs(exe)
        if langs is None:
            p('%s Tesseract 无法执行：%s' % (WARN, err))
            code = 3
        else:
            bad = [l for l in LANGS if l not in langs]
            if bad:
                p('%s Tesseract 缺语言包：%s' % (WARN, '、'.join(bad)))
                p('   修复：重跑 Tesseract 安装包 → Additional language data → 勾 vie / chi_sim / eng。')
                code = 3
            else:
                p('%s Tesseract 就绪（vie/eng/chi_sim 齐全）' % OK)

    # 端口
    okp, err = port_free(cfg.get('port') or 8000)
    if not okp:
        p('%s 端口 %s 被占用 → 服务会自动换到下一个可用端口（页面地址以窗口提示为准）'
          % (WARN, cfg.get('port')))
    else:
        p('%s 端口 %s 可用' % (OK, cfg.get('port')))

    # 数据文件夹
    sr = cfg.get('source_root') or ''
    if not sr or not os.path.isdir(sr):
        p('%s 数据文件夹还没填或不可用：%s' % (WARN, sr or '(空)'))
        p('   打开页面 http://127.0.0.1:8000/ 在「⓪ 数据文件夹地址」里填好并保存（例：D:/HUATEX）。')
        p('   ※ 只跑「Payment 核销」不需要这个；跑「进出口材料」必须填。')
        code = 3
    else:
        p('%s 数据文件夹有效：%s' % (OK, sr))

    p('── 自检结束（退出码 %d：0=通过，3=有警告）──' % code)
    return code


def selftest():
    p('包版本     : HUATEX Tools Windows %s' % 'v1-20261015')
    p('程序目录   : %s' % ROOT)
    p('检查时间   : %s' % datetime_now())
    p('解释器     : %s' % sys.executable)
    p('')
    code = 0

    # 1 运行环境
    ver = sys.version.split()[0]
    bits = python_bits()
    if sys.version_info >= (3, 11):
        p('%s [1/10] Python %s · %d 位' % (OK, ver, bits))
    elif sys.version_info >= (3, 9):
        p('%s [1/10] Python %s · %d 位（可用，但建议升到 3.11）' % (WARN, ver, bits))
        code = 3
    else:
        p('%s [1/10] Python %s 版本过低（需 3.9+）→ 请装 Python 3.11+' % (NO, ver))
        code = 2
    if bits != 64:
        p('      %s 32 位 Python 处理 23GB 级资料会很慢，建议换 64 位。' % WARN)

    # 2 目录与权限
    flags = []
    norm = os.path.normcase(ROOT)
    if 'program files' in norm or 'program files (x86)' in norm:
        flags.append('在 Program Files 下（可能无写权限）')
    if len(ROOT) > 180:
        flags.append('路径偏长（Windows 上限 260 字符）')
    okd, err = dir_writable(os.path.join(ROOT, 'runs'))
    okw, err2 = dir_writable(os.path.join(ROOT, 'work'))
    if okd and okw:
        p('%s [2/10] 程序目录可写（runs\\ 与 work\\ 均 OK）' % OK)
    else:
        p('%s [2/10] 程序目录不可写：%s %s' % (NO, err or '', err2 or ''))
        p('      处理：把整个文件夹移到「文档 / D 盘」等普通目录，别放 C:\\Program Files。')
        code = 2
    for f in flags:
        p('      %s %s' % (WARN, f))

    # 3 config.yaml
    st, msg = check_config_yaml()
    if st == 'ok':
        p('%s [3/10] %s' % (OK, msg))
    elif st == 'repaired':
        p('%s [3/10] %s' % (WARN, msg))
        p('      原因：页面上填了 D:\\HUATEX 这种带反斜杠的路径。建议以后填正斜杠：D:/HUATEX')
        code = 3
    else:
        p('%s [3/10] %s' % (NO, msg))
        p('      处理：用记事本打开 config.yaml，把每个路径两侧都加上单引号，例如')
        p("            source_root: 'D:/HUATEX'   （正斜杠最稳妥）")
        code = 2
    cfg = load_cfg()
    p('      source_root = %r' % (cfg.get('source_root') or ''))
    p('      output_root = %r' % (cfg.get('output_root') or ''))
    p('      runs_dir    = %r' % (cfg.get('runs_dir') or ''))
    p('      tesseract   = %r' % (cfg.get('tesseract_cmd') or ''))
    p('      port        = %s' % cfg.get('port'))

    # 4 输出根回落
    changed, old, new = fix_output_root(cfg)
    if changed:
        p('%s [4/10] 输出根 %s 所在盘不存在 → 已回落为 程序目录\\work\\' % (WARN, old))
        p('      如需固定到别的目录：改 config.yaml 的 paths.output_root。')
        code = max(code, 3) if code != 2 else code
    else:
        d = cfg.get('output_root') or ''
        d = d if os.path.isabs(d) else os.path.join(ROOT, d)
        ok, e = dir_writable(d)
        p('%s [4/10] 输出根可写：%s' % (OK if ok else NO, d) if ok else
          '%s [4/10] 输出根不可写：%s（%s）' % (NO, d, e))

    # 5 依赖
    have, miss = check_deps()
    if not miss:
        p('%s [5/10] 依赖 7/7 齐全' % OK)
    else:
        p('%s [5/10] 缺少依赖 %d 个：%s' % (NO, len(miss), '、'.join(miss)))
        p('      修复命令（联网）：')
        p('        %s -m pip install -r requirements.txt' % sys.executable)
        p('      修复命令（离线 wheel）：')
        p('        %s -m pip install --no-index --find-links=wheels -r requirements.txt' %
          sys.executable)
        code = max(code, 3) if code != 2 else code
    for h in have:
        p('      %s %s' % (OK, h))

    # 6 Tesseract
    exe, cand = find_tesseract(cfg)
    if not exe:
        p('%s [6/10] 没找到 tesseract.exe（扫描件 OCR 不可用）' % NO)
        p('      候选路径：%s' % ('、'.join(cand) or '(无)'))
        p('      修复：装 Tesseract-OCR（勾 vie / chi_sim / eng），再把 config.yaml 的')
        p('            ocr.tesseract_cmd 改成实际 tesseract.exe 路径。')
        code = max(code, 3) if code != 2 else code
    else:
        cfgp = (cfg.get('tesseract_cmd') or '')
        if cfgp and os.path.normcase(cfgp) != os.path.normcase(exe):
            p('%s [6/10] 注意：config.yaml 里配置的 tesseract_cmd 不存在 → %s' % (WARN, cfgp))
            p('      已改用 PATH 里找到的：%s' % exe)
            p('      建议把 config.yaml 的 ocr.tesseract_cmd 改成实际路径（单引号）。')
        langs, err = tesseract_langs(exe)
        if langs is None:
            p('%s [6/10] Tesseract 在 %s，但执行失败：%s' % (NO, exe, err))
            code = max(code, 3) if code != 2 else code
        else:
            bad = [l for l in LANGS if l not in langs]
            if bad:
                p('%s [6/10] Tesseract(%s) 缺语言包：%s（现有 %d 种）' %
                  (NO, exe, '、'.join(bad), len(langs)))
                p('      修复：重跑 Tesseract 安装包 → 勾 "Additional language data" → 选')
                p('            Vietnamese、Chinese (Simplified)、English，装完重跑本自检。')
                code = max(code, 3) if code != 2 else code
            else:
                p('%s [6/10] Tesseract 就绪（%s）· vie/eng/chi_sim 齐全' % (OK, exe))

    # 7 Poppler（pdf2image 依赖，扫描件 OCR 必需）
    pop = find_poppler()
    if pop:
        p('%s [7/10] Poppler/pdftoppm 已就位：%s' % (OK, pop))
    else:
        p('%s [7/10] 没找到 pdftoppm（Poppler）' % NO)
        p('      影响：扫描件 PDF 的 OCR 会报 PDFInfoNotInstalledError。')
        p('      修复：下载 Poppler for Windows 解压到本包（如 tools\\poppler），')
        p('            再设置环境变量 POPPLER_PATH 指向其 bin 目录，或把 bin 加进 PATH。')
        code = max(code, 3) if code != 2 else code

    # 8 端口
    port = cfg.get('port') or 8000
    okp, err = port_free(port)
    if okp:
        p('%s [8/10] 端口 %s 可用' % (OK, port))
    else:
        p('%s [8/10] 端口 %s 被占用（%s）' % (WARN, port, err))
        p('      服务会自动改用下一个可用端口，页面地址以启动窗口提示为准；')
        p('      也可能是本工具已在运行 → 直接打开 http://127.0.0.1:%s/ 试试。' % port)

    # 9 数据文件夹
    sr = cfg.get('source_root') or ''
    if not sr:
        p('%s [9/10] 数据文件夹还没填（页面 ⓪ 填写）' % WARN)
        p('      只跑「Payment 核销」不需要；跑「进出口材料」必须填。')
        code = max(code, 3) if code != 2 else code
    elif not os.path.isdir(sr):
        p('%s [9/10] 数据文件夹不存在：%s' % (NO, sr))
        p('      处理：确认盘符（换盘后盘符会变）与目录是否拷全，再在页面 ⓪ 重新填写。')
        code = max(code, 3) if code != 2 else code
    else:
        rmdb = os.path.join(sr, cfg.get('rm_db') or 'RM-Database')
        if os.path.isdir(rmdb):
            p('%s [9/10] 数据文件夹有效，且含 %s' % (OK, cfg.get('rm_db') or 'RM-Database'))
        else:
            p('%s [9/10] 数据文件夹存在，但没找到 %s\\' % (WARN, cfg.get('rm_db') or 'RM-Database'))
            p('      进出口材料流程需要它；支付核销流程不需要。')

    # 10 留痕目录
    okr, errr = dir_writable(os.path.join(ROOT, 'runs'))
    p('%s [10/10] 运行留痕目录可写：runs\\' % (OK if okr else NO) if okr else
      '%s [10/10] 运行留痕目录不可写（%s）' % (NO, errr))

    p('')
    if code == 0:
        p('== 自检结论：全部通过，双击 start.bat 即可使用 ==')
    elif code == 3:
        p('== 自检结论：有警告项（❌/⚠️）→ 相关流程可能失败，请按上面提示修复 ==')
    else:
        p('== 自检结论：发现致命问题（❌）→ 修好后再启动 ==')
    p('提示：把本报告整段复制发给管理员，可以最快定位问题。')
    return code


def datetime_now():
    import datetime
    return datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')


def main():
    if '--selftest' in sys.argv:
        return selftest()
    return quick()


if __name__ == '__main__':
    sys.exit(main())
'''

